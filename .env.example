# All keys are optional. Without them Backpack falls back to keyless
# providers (Open-Meteo, OpenStreetMap / Overpass, MyMemory).
# Keys can also be pasted in-app under Vault → Settings (stored on-device only).
VITE_GOOGLE_MAPS_KEY=
VITE_OPENWEATHER_KEY=
# Optional: Open Exchange Rates app id. Defaults to ExchangeRate-API open endpoint.
VITE_OXR_APP_ID=
# Optional: your own LLM/translation backend. POST {text, from, to} -> {translation}
VITE_TRANSLATE_ENDPOINT=
