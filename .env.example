# All keys are optional. Without them Backpack uses keyless providers
# (Open-Meteo, OpenStreetMap / Overpass, ParkenDD, DB HAFAS, MyMemory, iTunes Search).
# Keys can also be pasted in-app under Kit → Settings (stored on-device only).
VITE_GOOGLE_MAPS_KEY=
VITE_OPENWEATHER_KEY=
# Song recognition for Audio Scout (https://audd.io)
VITE_AUDD_TOKEN=
# Optional: Open Exchange Rates app id. Defaults to the ExchangeRate-API open endpoint.
VITE_OXR_APP_ID=
# Optional: your own LLM/translation backend. POST {text, from, to} -> {translation}
VITE_TRANSLATE_ENDPOINT=
# Optional: your own parking provider (e.g. a Parkopedia proxy). GET ?lat&lng&radius -> ParkingLot[]
VITE_PARKING_ENDPOINT=
